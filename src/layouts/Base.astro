---
import '../styles/global.css';
import '../styles/apurante.css';
import '../styles/plus.css';
import '../styles/plus-local.css';
import '../styles/theme.css';
import '../styles/editorial-light.css';
import '../styles/weather.css';
import '../styles/plus-control.css';
import '../styles/plus-backup.css';
import '../styles/edition.css';
import '../styles/editorial-system.css';
import '../styles/editorial-refinement.css';
import '../styles/home-visual.css';
import PlusBadge from '../components/PlusBadge.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import WeatherBar from '../components/WeatherBar.astro';
import EditionNotice from '../components/EditionNotice.astro';
import CalendarThemeBanner from '../components/CalendarThemeBanner.astro';
import { calendarThemes, resolveCalendarTheme } from '../lib/calendarThemes';
import {href,categories,categorySlug,jsonld} from '../lib/news';
const {title='Brasil. Mundo. Contexto.',description='Notícias do Brasil e do mundo com fontes identificadas, contexto e transparência editorial.',image='',article=false,noindex=false} = Astro.props;
const canonical = new URL(Astro.url.pathname,Astro.site).href;
const imageUrl = image?new URL(href(image),Astro.site).href:article?null:new URL(href('og.png'),Astro.site).href;
const siteTitle = `${title} | Apurante`;
const isPlusArea = Astro.url.pathname===href('mais/')||Astro.url.pathname===href('meu-apurante/');
const initialCalendarTheme = resolveCalendarTheme(new Date());
const initialCalendarStyle = initialCalendarTheme ? [
 `--calendar-light-accent:${initialCalendarTheme.palette.light.accent}`,
 `--calendar-light-accent-text:${initialCalendarTheme.palette.light.accentText}`,
 `--calendar-light-link-hover:${initialCalendarTheme.palette.light.linkHover}`,
 `--calendar-light-button-text:${initialCalendarTheme.palette.light.buttonText}`,
 `--calendar-light-surface-tint:${initialCalendarTheme.palette.light.surfaceTint}`,
 `--calendar-dark-accent:${initialCalendarTheme.palette.dark.accent}`,
 `--calendar-dark-accent-text:${initialCalendarTheme.palette.dark.accentText}`,
 `--calendar-dark-link-hover:${initialCalendarTheme.palette.dark.linkHover}`,
 `--calendar-dark-button-text:${initialCalendarTheme.palette.dark.buttonText}`,
 `--calendar-dark-surface-tint:${initialCalendarTheme.palette.dark.surfaceTint}`
].join(';') : undefined;
---
<!doctype html><html lang="pt-BR" data-theme="light" data-calendar-theme={initialCalendarTheme?.id} style={initialCalendarStyle}><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#f7f7f3"/><meta name="color-scheme" content="light dark"/>
<script is:inline>(()=>{const key='apurante_theme';let theme='light';try{const saved=localStorage.getItem(key);if(saved==='light'||saved==='dark')theme=saved;}catch{}const root=document.documentElement;const scheme=theme==='light'?'light':'dark';root.dataset.theme=theme;root.style.colorScheme=scheme;const themeMeta=document.querySelector('meta[name="theme-color"]');if(themeMeta)themeMeta.setAttribute('content',theme==='light'?'#f7f7f3':'#0a0c0f');const schemeMeta=document.querySelector('meta[name="color-scheme"]');if(schemeMeta)schemeMeta.setAttribute('content',scheme);})();</script>
<script is:inline define:vars={{calendarThemes}}>(()=>{const root=document.documentElement;const parts=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Sao_Paulo',month:'2-digit',day:'2-digit'}).formatToParts(new Date());const month=parts.find(part=>part.type==='month')?.value||'01';const day=parts.find(part=>part.type==='day')?.value||'01';const key=`${month}-${day}`;const inside=(start,end)=>start<=end?(key>=start&&key<=end):(key>=start||key<=end);const active=calendarThemes.find(theme=>inside(theme.start,theme.end));const properties=['accent','accentText','linkHover','buttonText','surfaceTint'];const cssName=value=>value.replace(/[A-Z]/g,match=>`-${match.toLowerCase()}`);if(!active){delete root.dataset.calendarTheme;['light','dark'].forEach(mode=>properties.forEach(property=>root.style.removeProperty(`--calendar-${mode}-${cssName(property)}`)));return;}root.dataset.calendarTheme=active.id;['light','dark'].forEach(mode=>properties.forEach(property=>root.style.setProperty(`--calendar-${mode}-${cssName(property)}`,active.palette[mode][property])));})();</script>
<title>{siteTitle}</title><meta name="description" content={description}/>
<link rel="canonical" href={canonical}/><link rel="icon" href={href('favicon.svg')} type="image/svg+xml"/>
<meta property="og:site_name" content="Apurante"/><meta property="og:locale" content="pt_BR"/><meta property="og:type" content={article?'article':'website'}/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
{imageUrl&&<meta property="og:image" content={imageUrl}/>}
<meta name="twitter:card" content={imageUrl?'summary_large_image':'summary'}/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/>
{imageUrl&&<meta name="twitter:image" content={imageUrl}/>}
{noindex&&<meta name="robots" content="noindex,follow"/>}
<script type="application/ld+json" set:html={jsonld({'@context':'https://schema.org','@type':'Organization',name:'Apurante',url:new URL(href(),Astro.site).href,logo:new URL(href('favicon.svg'),Astro.site).href})}/>
<slot name="head"/>
</head><body id="topo">
<a class="skip" href="#conteudo">Ir para o conteúdo</a>
<header class="site-header"><EditionNotice/><WeatherBar/><div class="wrap masthead"><a href={isPlusArea?href('mais/'):href()} class="wordmark" aria-label={isPlusArea?'APURANTE+ — início':'Apurante — início'}>APURANTE{isPlusArea?<span class="brand-plus" aria-hidden="true">+</span>:<span class="brand-point" aria-hidden="true">.</span>}</a><p class="motto">INFORMAÇÃO QUE VAI<br/>ALÉM DA MANCHETE.</p><div class="header-actions"><ThemeToggle/><PlusBadge compact destination="mais/" label="Conhecer o APURANTE+"/><a href={href('busca/')} aria-label="Buscar notícias"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/><path d="m15 15 6 6" stroke="currentColor" stroke-width="1.5"/></svg><span>Buscar</span></a></div></div>
<nav class="wrap categories" aria-label="Editorias"><a href={href()} class:list={{active:Astro.url.pathname===href()}} aria-label="Voltar ao início do APURANTE">Início</a><a href={href('eleicoes/')} class:list={{active:Astro.url.pathname===href('eleicoes/')}}>Eleições 2026</a>{categories.map(c=><a href={href(`categoria/${categorySlug(c)}/`)} class:list={{active:Astro.url.pathname===href(`categoria/${categorySlug(c)}/`)}}>{c}</a>)}</nav><CalendarThemeBanner/></header>
<main id="conteudo" class="wrap"><slot/></main>
<footer class="site-footer"><div class="wrap footer-top"><div><a href={href()} class="wordmark small">APURANTE<span class="brand-point" aria-hidden="true">.</span></a><p>Informação que vai além da manchete.</p></div><nav aria-label="Institucional"><a href={href('mais/')}>APURANTE+</a><a href={href('meu-apurante/')}>Meu APURANTE+</a><a href={href('sobre/')}>Sobre</a><a href={href('politica-editorial/')}>Política editorial</a><a href={href('fontes/')}>Fontes</a><a href={href('arquivo/')}>Arquivo</a></nav></div><div class="wrap footer-bottom"><p>© {new Date().getUTCFullYear()} Apurante</p><p>Fatos em perspectiva. Fontes identificadas. Compromisso com a informação.</p><a href="#topo" id="back-top">Voltar ao topo ↑</a></div></footer>
<script>document.getElementById('back-top')?.addEventListener('click',e=>{e.preventDefault();window.scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});document.querySelector<HTMLAnchorElement>('.wordmark')?.focus();});</script>
</body></html>

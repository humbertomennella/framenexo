---
import Base from '../layouts/Base.astro';
---
<Base title="Busca" description="Encontre notícias por título, editoria, tag ou palavra-chave." noindex><header class="page-head"><span class="eyebrow">Encontre a próxima notícia</span><h1>O que você está procurando?</h1><p>Busque por país, tema, instituição ou palavra-chave.</p></header><form class="search-form" id="search-form" role="search"><div><label for="query">Buscar notícias</label><input id="query" name="q" type="search" autocomplete="off" placeholder="Brasil, ciência, economia…"/></div><div><label for="category">Editoria</label><select id="category" name="categoria"><option value="">Todas as editorias</option></select></div><button class="button" type="submit">Buscar ↗</button></form><p class="search-status" id="search-status" role="status" aria-live="polite">Carregando índice de notícias…</p><div class="search-results" id="search-results"></div><noscript><p>A busca precisa de JavaScript. Você pode navegar pelas editorias ou por Últimas Notícias.</p></noscript></Base>
<script>
const form=document.querySelector<HTMLFormElement>('#search-form')!;const input=document.querySelector<HTMLInputElement>('#query')!;const category=document.querySelector<HTMLSelectElement>('#category')!;const status=document.querySelector('#search-status')!;const results=document.querySelector('#search-results')!;let records:any[]=[];let loaded=false;
function normalized(s:string){return s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase()}
function search(){if(!loaded)return;const terms=normalized(input.value.trim()).split(/\s+/).filter(Boolean);const chosen=category.value;const found=records.filter(a=>(!chosen||a.category===chosen||a.tags.includes(chosen))&&terms.every(t=>normalized(`${a.title} ${a.description} ${a.category} ${a.tags.join(' ')} ${a.keywords}`).includes(t)));results.replaceChildren();status.textContent=`${found.length} ${found.length===1?'notícia encontrada':'notícias encontradas'}.`;for(const a of found){const article=document.createElement('article');article.className='search-result';const label=document.createElement('small');label.textContent=a.category;const h=document.createElement('h2');const link=document.createElement('a');link.href=a.url;link.textContent=a.title;h.append(link);const p=document.createElement('p');p.textContent=a.description;article.append(label,h,p);results.append(article)}if(!found.length){const p=document.createElement('p');p.textContent='Nenhuma notícia corresponde à busca.';results.append(p)}}
form.addEventListener('submit',e=>{e.preventDefault();search()});category.addEventListener('change',search);fetch('/search-index.json').then(r=>r.json()).then(data=>{records=data;for(const c of [...new Set(records.map(a=>a.category))]){const o=document.createElement('option');o.value=c;o.textContent=c;category.append(o)}loaded=true;search()}).catch(()=>{status.textContent='Não foi possível carregar a busca.'});
</script>

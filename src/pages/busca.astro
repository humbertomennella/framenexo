---
import Base from '../layouts/Base.astro';
import {href} from '../lib/news';
---
<Base title="Busca" description="Encontre notícias por título, editoria, tag ou palavra-chave." noindex><header class="page-head"><span class="eyebrow">Encontre a próxima notícia</span><h1>O que você está procurando?</h1><p>Busque por país, tema, instituição ou palavra-chave.</p></header><form class="search-form" id="search-form" role="search" data-index-url={href('search-index.json')}><div><label for="query">Buscar notícias</label><input id="query" name="q" type="search" autocomplete="off" placeholder="Brasil, ciência, economia…"/></div><div><label for="category">Editoria</label><select id="category" name="categoria"><option value="">Todas as editorias</option></select></div><button class="button" type="submit">Buscar ↗</button></form><p class="search-status" id="search-status" role="status" aria-live="polite">Carregando índice de notícias…</p><div class="search-results" id="search-results"></div><noscript><p>A busca precisa de JavaScript. Você pode navegar pelas editorias ou por Últimas Notícias.</p></noscript></Base>
<script>
const form=document.querySelector<HTMLFormElement>('#search-form')!;const input=document.querySelector<HTMLInputElement>('#query')!;const category=document.querySelector<HTMLSelectElement>('#category')!;const status=document.querySelector('#search-status')!;const results=document.querySelector('#search-results')!;let records:any[]=[];let loaded=false;
function normalized(s:string){return s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase()}
function search(){if(!loaded)return;const terms=normalized(input.value.trim()).split(/\s+/).filter(Boolean);const chosen=category.value;const found=records.filter(a=>(!chosen||a.category===chosen||a.tags.includes(chosen))&&terms.every(t=>normalized(`${a.title} ${a.description} ${a.category} ${a.tags.join(' ')} ${a.keywords}`).includes(t))).sort((a,b)=>Number(b.prominenceEligible)-Number(a.prominenceEligible));results.replaceChildren();status.textContent=`${found.length} ${found.length===1?'notícia encontrada':'notícias encontradas'}.`;for(const a of found){const article=document.createElement('article');article.className='search-result';const label=document.createElement('small');label.textContent=a.prominenceEligible?a.category:`${a.category} · Acervo em revisão`;const h=document.createElement('h2');const link=document.createElement('a');link.href=a.url;link.textContent=a.title;h.append(link);const p=document.createElement('p');p.textContent=a.description;article.append(label,h,p);results.append(article)}if(!found.length){const p=document.createElement('p');p.textContent='Nenhuma notícia corresponde à busca.';results.append(p)}}
const params=new URLSearchParams(location.search);input.value=params.get('q')||'';
form.addEventListener('submit',e=>{e.preventDefault();const next=new URL(location.href);input.value.trim()?next.searchParams.set('q',input.value.trim()):next.searchParams.delete('q');category.value?next.searchParams.set('categoria',category.value):next.searchParams.delete('categoria');history.replaceState({},'',next);search()});category.addEventListener('change',search);fetch(form.dataset.indexUrl!).then(r=>{if(!r.ok)throw new Error(`HTTP ${r.status}`);return r.json()}).then(data=>{records=data;for(const c of [...new Set(records.map(a=>a.category))]){const o=document.createElement('option');o.value=c;o.textContent=c;category.append(o)}category.value=params.get('categoria')||'';loaded=true;search()}).catch(()=>{status.textContent='Não foi possível carregar a busca. Tente novamente ou navegue pelas editorias.'});
</script>

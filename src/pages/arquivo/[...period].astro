---
import Base from '../../layouts/Base.astro';import {articles,href,articleUrl,date,time} from '../../lib/news';
export function getStaticPaths(){return [undefined,...new Set(articles.flatMap(a=>[a.publishedAt.slice(0,4),`${a.publishedAt.slice(0,4)}/${a.publishedAt.slice(5,7)}`]))].map(period=>({params:{period}}))}
const p=Astro.params.period;const items=articles.filter(a=>!p||a.publishedAt.replace('-','/').startsWith(p));const years=[...new Set(articles.map(a=>a.publishedAt.slice(0,4)))];const months=[...new Set(articles.map(a=>`${a.publishedAt.slice(0,4)}/${a.publishedAt.slice(5,7)}`))];
---
<Base title={`Arquivo${p?' — '+p:''}`} description="Explore as publicações do Apurante por ano e mês."><header class="page-head"><span class="eyebrow">Memória editorial</span><h1>Arquivo{p&&` / ${p}`}</h1><p>Todas as publicações, em ordem cronológica.</p></header><nav class="archive-links" aria-label="Período do arquivo"><a href={href('arquivo/')}>Todo o arquivo</a>{years.map(y=><a href={href(`arquivo/${y}/`)}>{y}</a>)}{months.map(m=><a href={href(`arquivo/${m}/`)}>{m}</a>)}</nav><section class="page-section" aria-label="Publicações no período">{items.map(a=><article class="news-row"><time datetime={a.publishedAt}>{date(a.publishedAt)}<br/>{time(a.publishedAt)} BRT</time><div><h2 style="font-size:24px;margin-bottom:9px"><a href={articleUrl(a)}>{a.title}</a></h2><span class="eyebrow">{a.category}</span></div></article>)}</section></Base>

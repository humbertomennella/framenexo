---
import Base from '../../layouts/Base.astro';
import {articles,href,articleUrl,date,time} from '../../lib/news';
import {groupByEdition} from '../../lib/editions';
export function getStaticPaths(){return [undefined,...new Set(articles.flatMap(a=>[a.publishedAt.slice(0,4),`${a.publishedAt.slice(0,4)}/${a.publishedAt.slice(5,7)}`]))].map(period=>({params:{period}}))}
const p=Astro.params.period;
const items=articles.filter(a=>!p||a.publishedAt.replace('-','/').startsWith(p));
const groups=groupByEdition(items);
const years=[...new Set(articles.map(a=>a.publishedAt.slice(0,4)))];
const months=[...new Set(articles.map(a=>`${a.publishedAt.slice(0,4)}/${a.publishedAt.slice(5,7)}`))];
---
<Base title={`Arquivo${p?' — '+p:''}`} description="Explore as publicações e edições do APURANTE por ano e mês.">
<header class="page-head"><span class="eyebrow">Memória editorial</span><h1>Arquivo{p&&` / ${p}`}</h1><p>As publicações regulares são agrupadas pelos fechamentos das 08h, 13h, 18h e 22h, no horário de Brasília. Edições extraordinárias aparecem separadamente.</p></header>
<nav class="archive-links" aria-label="Período do arquivo"><a href={href('arquivo/')}>Todo o arquivo</a>{years.map(y=><a href={href(`arquivo/${y}/`)}>{y}</a>)}{months.map(m=><a href={href(`arquivo/${m}/`)}>{m}</a>)}</nav>
<div class="archive-editions">
{groups.map(group=><section class="archive-edition" aria-label={group.label}>
 <header class="archive-edition-head"><div><span class="eyebrow">{group.type==='extraordinary'?'EDIÇÃO EXTRAORDINÁRIA':group.type==='scheduled'?'EDIÇÃO PROGRAMADA':'ARQUIVO ANTERIOR'}</span><h2>{group.type==='legacy'?date(group.slot):group.label}</h2></div><p>{group.items.length} {group.items.length===1?'matéria':'matérias'} · {date(group.slot)}{group.type!=='legacy'?` · ${time(group.slot)} BRT`:''}</p></header>
 <div>{group.items.map(a=><article class="news-row"><time datetime={a.publishedAt}>{time(a.publishedAt)} BRT<br/>{a.category}</time><div><h3><a href={articleUrl(a)}>{a.title}</a></h3><span class="eyebrow">{a.description}</span></div></article>)}</div>
</section>)}
</div>
</Base>

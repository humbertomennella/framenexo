---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Headlines from '../components/Headlines.astro';
import {articles,articleUrl,href,date,categories,categorySlug,inCategory} from '../lib/news';
import {selectHighlights} from '../lib/highlights.mjs';
// “Em Alta” is selected first; the lead carousel then uses different stories.
const highlights=selectHighlights(articles);
const highlightSlugs=new Set(highlights.map(a=>a.slug));
const featured=articles.filter(a=>!highlightSlugs.has(a.slug)).slice(0,Math.min(3,articles.length));
const featuredSlugs=new Set(featured.map(a=>a.slug));
const recent=articles.filter(a=>!featuredSlugs.has(a.slug)&&!highlightSlugs.has(a.slug)).slice(0,3);
const sections=categories.map(category=>({category,items:articles.filter(a=>inCategory(a,category))})).filter(section=>section.items.length);
---
<Base>
 <h1 class="sr-only">Apurante — notícias do Brasil e do mundo</h1>
 <div class="front-grid"><Headlines articles={featured}/><Headlines articles={highlights} variant="moment"/></div>
 {recent.length>0&&<section class="section"><div class="section-heading"><h2>Mais recentes</h2><a href={href('ultimas/')}>Todas as notícias ↗</a></div><div class="cards">{recent.map(a=><Card article={a}/>)}</div></section>}
 <div class="editorial-strip"><div><strong>Brasil e mundo, com contexto.</strong><p>Leitura rápida para se situar. Matérias completas para entender.</p></div><a href={href('politica-editorial/')}>Conheça nossa política editorial ↗</a></div>
 <div class="editorial-sections">{sections.map(({category,items})=><section class="editoria-block" aria-label={category}><div class="section-heading"><h2><a href={href(`categoria/${categorySlug(category)}/`)}>{category}</a></h2><a href={href(`categoria/${categorySlug(category)}/`)}>Ver editoria · {items.length} ↗</a></div><div class="editoria-grid"><article class="editoria-lead"><a href={articleUrl(items[0])} tabindex="-1" aria-hidden="true"><img src={href(items[0].image)} alt="" width="1200" height="675" loading="lazy" decoding="async"/></a><div><span class="eyebrow">{date(items[0].publishedAt)}</span><h3><a href={articleUrl(items[0])}>{items[0].title}</a></h3><p>{items[0].description}</p></div></article><div class="editoria-links">{items.slice(1,5).map(a=><a href={articleUrl(a)}>{a.title}<span aria-hidden="true">↗</span></a>)}</div></div></section>)}</div>
 <div class="lower-grid"><section><div class="section-heading"><h2>Últimas publicações</h2><a href={href('arquivo/')}>Arquivo ↗</a></div>{articles.slice(0,8).map(a=><article class="news-row"><time datetime={a.publishedAt}>{date(a.publishedAt)}<br/>{a.category}</time><div><h3><a href={articleUrl(a)}>{a.title}</a></h3><span class="eyebrow">{a.description}</span></div></article>)}</section><aside><div class="section-heading"><h2>Editorias</h2></div><div class="topic-list">{categories.map(c=><a href={href(`categoria/${categorySlug(c)}/`)}>{c}<span>{String(articles.filter(a=>inCategory(a,c)).length).padStart(2,'0')}</span></a>)}</div><div class="reader-box"><span class="eyebrow">Sua próxima leitura</span><h3>O Brasil e o mundo, em perspectiva.</h3><p>Encontre um assunto, compare as fontes e acompanhe os próximos desdobramentos.</p><a class="button" href={href('busca/')}>Explorar notícias ↗</a></div></aside></div>
</Base>

---
import Base from '../layouts/Base.astro';import Card from '../components/Card.astro';
import {articles,articleUrl,href,date,time,reading,categories,categorySlug,inCategory} from '../lib/news';
import state from '../../data/publishing-state.json';
const relevant=[...articles].sort((a,b)=>b.relevance-a.relevance);const hero=relevant[0];
---
<Base><div class="edition-bar"><span><i class="live-dot"></i><strong>Em foco</strong> / Edição {String(state.editionCount).padStart(2,'0')}</span><span>{hero?date(hero.publishedAt):'Notícias com contexto'}</span></div>
{hero?<section class="hero-grid" aria-label="Destaques"><article class="hero"><img src={href(hero.image)} alt={hero.imageAlt} width="1440" height="810" fetchpriority="high" decoding="async"/><div class="hero-copy"><a class="eyebrow" href={href(`categoria/${categorySlug(hero.category)}/`)}>{hero.category} / Destaque</a><h1><a href={articleUrl(hero)}>{hero.title}</a></h1><p>{hero.description}</p><div class="meta"><time datetime={hero.publishedAt}>{date(hero.publishedAt)} · {time(hero.publishedAt)} BRT</time><span>{reading(hero)} min de leitura</span></div><a class="read-link" href={articleUrl(hero)}>Ler a matéria <span class="arrow" aria-hidden="true">↗</span></a></div></article><aside class="radar"><h2>No radar</h2>{relevant.slice(1,4).map((a,i)=><article class="radar-item"><span class="radar-number">0{i+1}</span><div><a class="eyebrow" href={href(`categoria/${categorySlug(a.category)}/`)}>{a.category}</a><h3><a href={articleUrl(a)}>{a.title}</a></h3><div class="meta"><span>{a.confidence==='RELATO'?'Relato da fonte':'Anúncio oficial'}</span><span>{reading(a)} min</span></div></div></article>)}</aside></section>:<h1>Games. Contexto. Próximo frame.</h1>}
<section class="section"><div class="section-heading"><h2>Além do destaque</h2><a href={href('ultimas/')}>Todas as notícias ↗</a></div><div class="cards">{relevant.slice(3,6).map(a=><Card article={a}/>)}</div></section>
<div class="editorial-strip"><div><strong>O fato primeiro. O contexto, junto.</strong><p>Fontes identificadas, rumores sinalizados e transparência sobre o uso de IA.</p></div><a href={href('politica-editorial/')}>Conheça nossa política editorial ↗</a></div>
<div class="lower-grid"><section><div class="section-heading"><h2>Últimas publicações</h2><a href={href('arquivo/')}>Arquivo ↗</a></div>{articles.slice(0,8).map(a=><article class="news-row"><time datetime={a.publishedAt}>{date(a.publishedAt)}<br/>{time(a.publishedAt)} BRT</time><div><h3><a href={articleUrl(a)}>{a.title}</a></h3><span class="eyebrow">{a.category}</span></div></article>)}</section><aside><div class="section-heading"><h2>Seu próximo universo</h2></div><div class="topic-list">{categories.map(c=><a href={href(`categoria/${categorySlug(c)}/`)}>{c}<span>{String(articles.filter(a=>inCategory(a,c)).length).padStart(2,'0')}</span></a>)}</div><div class="rss-box"><span class="eyebrow">Sem ruído</span><h3>As notícias no seu ritmo.</h3><p>Adicione o FrameNexo ao seu leitor de RSS e acompanhe cada publicação.</p><a class="button" href={href('rss.xml')}>Acompanhar pelo RSS ↗</a></div></aside></div></Base>

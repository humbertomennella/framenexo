---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Elections from '../components/Elections.astro';
import EditorialCover from '../components/EditorialCover.astro';
import HomePersonalization from '../components/HomePersonalization.astro';
import HomePlusFeed from '../components/HomePlusFeed.astro';
import {articles,articleUrl,href,date,reading,categories,categorySlug,inCategory,usesEditorialCover} from '../lib/news';
import {selectHighlights} from '../lib/highlights.mjs';

const highlights=selectHighlights(articles);
const urgent=highlights.filter(a=>a.highlightLabel==='URGENTE');
const lead=urgent[0]||articles[0];
const leadSlug=lead?.slug;
const focus=highlights.filter(a=>a.slug!==leadSlug).slice(0,3);
const reserved=new Set([leadSlug,...focus.map(a=>a.slug)].filter(Boolean));
const latest=articles.filter(a=>!reserved.has(a.slug)).slice(0,6);
const sections=categories.map(category=>({category,items:articles.filter(a=>inCategory(a,category)).slice(0,2)})).filter(section=>section.items.length);
---
<Base>
 <div class="home-page home-editorial">
  <h1 class="sr-only">Apurante — notícias do Brasil e do mundo</h1>

  {urgent.length>0&&<aside class="breaking-strip" aria-label="Notícia urgente">
   <span>URGENTE</span>
   <a href={articleUrl(urgent[0])}>{urgent[0].title}</a>
   <time datetime={urgent[0].publishedAt}>{date(urgent[0].publishedAt)}</time>
  </aside>}

  {lead&&<section class="lead-zone" aria-label="Destaques do APURANTE">
   <article class="lead-story">
    <a class="lead-media" href={articleUrl(lead)} tabindex="-1" aria-hidden="true">
     {usesEditorialCover(lead)?<EditorialCover article={lead} compact/>:<img src={href(lead.image)} alt="" width="1440" height="810" fetchpriority="high" decoding="async"/>}
    </a>
    <div class="lead-copy">
     <div class="lead-meta"><a class="eyebrow" href={href(`categoria/${categorySlug(lead.category)}/`)}>{lead.category}</a><time datetime={lead.publishedAt}>{date(lead.publishedAt)}</time><span>{reading(lead)} min</span></div>
     <h2><a href={articleUrl(lead)}>{lead.title}</a></h2>
     <p>{lead.description}</p>
     <a class="lead-read" href={articleUrl(lead)}>Ler matéria completa <span aria-hidden="true">→</span></a>
    </div>
   </article>

   <aside class="focus-rail" aria-label="Em foco">
    <header><div><span class="eyebrow">EM FOCO</span><h2>O que merece atenção agora</h2></div><a href={href('ultimas/')}>Últimas ↗</a></header>
    <div class="focus-list">
     {focus.length>0?focus.map((a,index)=><article class="focus-item">
      <span class:list={["focus-index",a.highlightLabel==='URGENTE'&&"is-urgent"]}>{a.highlightLabel==='URGENTE'?'URGENTE':String(index+1).padStart(2,'0')}</span>
      <div><a class="eyebrow" href={href(`categoria/${categorySlug(a.category)}/`)}>{a.category}</a><h3><a href={articleUrl(a)}>{a.title}</a></h3><div class="meta"><time datetime={a.publishedAt}>{date(a.publishedAt)}</time><span>{reading(a)} min</span></div></div>
     </article>):<p class="focus-empty">Nenhuma pauta extraordinária neste momento. A edição segue com as notícias verificadas mais recentes.</p>}
    </div>
   </aside>
  </section>}

  {latest.length>0&&<section class="section latest-zone">
   <div class="section-heading"><div><span class="section-kicker">AGORA</span><h2>Mais recentes</h2></div><a href={href('ultimas/')}>Todas as notícias ↗</a></div>
   <div class="latest-grid">{latest.slice(0,3).map(a=><Card article={a}/>)}</div>
   {latest.length>3&&<div class="latest-lines">{latest.slice(3,6).map(a=><article><a class="eyebrow" href={href(`categoria/${categorySlug(a.category)}/`)}>{a.category}</a><h3><a href={articleUrl(a)}>{a.title}</a></h3><time datetime={a.publishedAt}>{date(a.publishedAt)} · {reading(a)} min</time></article>)}</div>}
  </section>}

  <section class="elections-home" aria-label="Eleições 2026"><Elections compact/></section>

  <HomePersonalization/>

  <section class="edition-promise" aria-labelledby="edition-promise-title">
   <div><span class="eyebrow">EDIÇÃO HORÁRIA</span><h2 id="edition-promise-title">Dez editorias. Meta de vinte matérias verificadas.</h2></div>
   <p>O APURANTE tenta entregar duas matérias por editoria em cada fechamento. A cota nunca substitui evidência: uma pauta sem informação suficiente fica de fora.</p>
   <a href={href('politica-editorial/')}>Como verificamos ↗</a>
  </section>

  <div class="editorial-sections" data-home-sections>
   {sections.map(({category,items},index)=><section class="editoria-block" data-home-category={category} data-home-index={index} aria-label={category}>
    <div class="section-heading"><div><span class="section-kicker">EDITORIA</span><h2><a href={href(`categoria/${categorySlug(category)}/`)}>{category}</a></h2></div><a href={href(`categoria/${categorySlug(category)}/`)}>Ver editoria ↗</a></div>
    <div class="editoria-pair">
     <article class="editoria-primary">
      <a class="editoria-media" href={articleUrl(items[0])} tabindex="-1" aria-hidden="true">{usesEditorialCover(items[0])?<EditorialCover article={items[0]} compact/>:<img src={href(items[0].image)} alt="" width="960" height="540" loading="lazy" decoding="async"/>}</a>
      <div><div class="meta"><time datetime={items[0].publishedAt}>{date(items[0].publishedAt)}</time><span>{reading(items[0])} min</span></div><h3><a href={articleUrl(items[0])}>{items[0].title}</a></h3><p>{items[0].description}</p></div>
     </article>
     {items[1]&&<article class="editoria-secondary"><span class="eyebrow">SEGUNDA LEITURA</span><h3><a href={articleUrl(items[1])}>{items[1].title}</a></h3><p>{items[1].description}</p><div class="meta"><time datetime={items[1].publishedAt}>{date(items[1].publishedAt)}</time><span>{reading(items[1])} min</span></div></article>}
    </div>
   </section>)}
  </div>

  <HomePlusFeed/>

  <div class="editorial-strip"><div><strong>Brasil e mundo, com contexto.</strong><p>Leitura rápida para se situar. Matéria completa para entender. Fontes abertas para conferir.</p></div><a href={href('fontes/')}>Conheça as fontes ↗</a></div>

  <section class="home-directory" aria-label="Navegação por editorias">
   <div class="section-heading"><div><span class="section-kicker">NAVEGUE</span><h2>Todas as editorias</h2></div><a href={href('arquivo/')}>Arquivo completo ↗</a></div>
   <div class="topic-list">{categories.map(c=><a href={href(`categoria/${categorySlug(c)}/`)}>{c}<span>{String(articles.filter(a=>inCategory(a,c)).length).padStart(2,'0')}</span></a>)}</div>
  </section>
 </div>
</Base>

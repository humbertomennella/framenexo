---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import {articles,articleUrl,href,date,time,reading,categorySlug,jsonld,usesEditorialCover,independentSourceCount,displayedConfidence} from '../../lib/news';
import EditorialCover from '../../components/EditorialCover.astro';

export function getStaticPaths(){return articles.map(a=>({params:{slug:a.slug},props:{article:a}}))}
const {article:a}=Astro.props;
const Content=a.Content;
const url=new URL(articleUrl(a),Astro.site).href;
const useEditorialCover=usesEditorialCover(a);
const newsSchema:any={'@context':'https://schema.org','@type':'NewsArticle',headline:a.title,description:a.description,datePublished:a.publishedAt,dateModified:a.updatedAt,mainEntityOfPage:url,author:{'@type':'Organization',name:'Apurante Editorial',url:new URL(href('sobre/'),Astro.site).href},publisher:{'@type':'Organization',name:'Apurante'},articleSection:a.category,keywords:a.tags.join(', '),citation:a.sources.map(s=>s.url)};
if(!useEditorialCover)newsSchema.image=[new URL(href(a.image),Astro.site).href];
const related=articles.filter(b=>b.slug!==a.slug&&(b.category===a.category||b.tags.some(t=>a.tags.includes(t)))).slice(0,3);
const sourceRoutes=independentSourceCount(a);
const confidence=displayedConfidence(a);
const sourceRole=(source:any)=>source.role==='wire'?'Agência de notícias':source.role==='specialist'?'Cobertura especializada':source.role==='discovery'?'Descoberta de pauta':source.type==='primary'?'Fonte primária':'Imprensa / contexto';
---
<Base title={a.title} description={a.description} image={useEditorialCover?'':a.image} article>
 <Fragment slot="head">
  <meta property="article:published_time" content={a.publishedAt}/><meta property="article:modified_time" content={a.updatedAt}/>
  <script type="application/ld+json" set:html={jsonld(newsSchema)}/>
  <script type="application/ld+json" set:html={jsonld({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Início',item:new URL(href(),Astro.site).href},{'@type':'ListItem',position:2,name:a.category,item:new URL(href(`categoria/${categorySlug(a.category)}/`),Astro.site).href},{'@type':'ListItem',position:3,name:a.title,item:url}]})}/>
 </Fragment>
 <article>
  <header class="article-head">
   <nav class="breadcrumbs" aria-label="Caminho de navegação"><a href={href()}>Início</a><span aria-hidden="true">/</span><a href={href(`categoria/${categorySlug(a.category)}/`)}>{a.category}</a><span aria-hidden="true">/</span><span>Notícia</span></nav>
   <a class="eyebrow" href={href(`categoria/${categorySlug(a.category)}/`)}>{a.category}</a><span class="badge">{confidence}</span>
   <h1>{a.title}</h1><p class="dek">{a.description}</p>
   <div class="article-byline"><strong>Apurante Editorial</strong> · <time datetime={a.publishedAt}>{date(a.publishedAt)}, {time(a.publishedAt)} BRT</time> · {reading(a)} min de leitura{a.updatedAt!==a.publishedAt&&<span> · Atualizado em {date(a.updatedAt)}, {time(a.updatedAt)} BRT</span>}</div>
  </header>
  <figure class="article-figure">{useEditorialCover?<EditorialCover article={a}/>:<img src={href(a.image)} alt={a.imageAlt} width="1440" height="810" fetchpriority="high"/>}<figcaption>{useEditorialCover?'Capa editorial tipográfica do Apurante. Não representa fotografia do acontecimento.':a.imageCredit}</figcaption></figure>
  <nav class="reading-choices" aria-label="Escolha o modo de leitura"><a href="#rapida">Resumo em 30 segundos</a><a href="#materia">Matéria completa · {reading(a)} min</a></nav>
  <div class="article-reading">
   <aside class="quick-read" id="rapida"><span class="eyebrow">Leitura rápida</span><h2>Em 30 segundos</h2><p>{a.description}</p><ul>{(a.quickTakeaways||[a.description]).map(item=><li>{item}</li>)}</ul><a href="#materia" class="quick-jump">Ir para a matéria completa ↓</a></aside>
   <div class="article-text">
    <div id="materia" class="article-context"><span class="eyebrow">Matéria completa</span><Content/></div>
    <aside class="source-box"><div class="source-box-head"><h2>Fontes desta matéria</h2><span>{sourceRoutes} {sourceRoutes===1?'rota independente':'rotas independentes'}</span></div><p>Os links abaixo sustentam os fatos descritos. Documento primário, agência e redação são funções diferentes; republicações da mesma apuração contam como uma única rota.</p>{sourceRoutes<2&&<p class="source-warning"><strong>Transparência:</strong> esta publicação do acervo anterior possui somente uma rota identificada. Ela permanece disponível, mas não atende à regra atual para novas matérias completas.</p>}<ol>{a.sources.map(s=><li><a href={s.url} rel="noopener noreferrer">{s.name} ↗</a><span class="source-kind">{sourceRole(s)}</span><time datetime={s.publishedAt}>{date(s.publishedAt)}</time></li>)}</ol></aside>
    <p class="disclosure">Produção da Apurante Editorial com inteligência artificial. As ilustrações não são fotografias. Consulte as fontes, os limites da apuração e a <a href={href('politica-editorial/')}>política editorial</a>.</p>
    {a.corrections?.length>0&&<section><h2>Correções</h2>{a.corrections.map(c=><p class="disclosure"><time datetime={c.date}>{date(c.date)}</time> — {c.text}</p>)}</section>}
    <nav class="tags" aria-label="Tags">{a.tags.map(t=><a href={`${href('busca/')}?q=${encodeURIComponent(t)}`}>{t}</a>)}</nav>
   </div>
  </div>
 </article>
 {related.length>0&&<section class="page-section"><div class="section-heading"><h2>Continue a leitura</h2></div><div class="cards">{related.map(b=><Card article={b}/>)}</div></section>}
</Base>

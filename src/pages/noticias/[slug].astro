---
import Base from '../../layouts/Base.astro';import Card from '../../components/Card.astro';import {articles,articleUrl,href,date,time,reading,categorySlug,jsonld} from '../../lib/news';
export function getStaticPaths(){return articles.map(a=>({params:{slug:a.slug},props:{article:a}}))}
const {article:a}=Astro.props;const Content=a.Content;const url=new URL(articleUrl(a),Astro.site).href;
const related=articles.filter(b=>b.slug!==a.slug&&(b.category===a.category||b.tags.some(t=>a.tags.includes(t)))).slice(0,3);
---
<Base title={a.title} description={a.description} image={a.image} article><Fragment slot="head"><meta property="article:published_time" content={a.publishedAt}/><meta property="article:modified_time" content={a.updatedAt}/><script type="application/ld+json" set:html={jsonld({'@context':'https://schema.org','@type':'NewsArticle',headline:a.title,description:a.description,datePublished:a.publishedAt,dateModified:a.updatedAt,mainEntityOfPage:url,image:[new URL(href(a.image),Astro.site).href],author:{'@type':'Organization',name:'Redação FrameNexo',url:new URL(href('sobre/'),Astro.site).href},publisher:{'@type':'Organization',name:'FrameNexo'},articleSection:a.category,keywords:a.tags.join(', '),citation:a.sources.map(s=>s.url)})}/><script type="application/ld+json" set:html={jsonld({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Início',item:new URL(href(),Astro.site).href},{'@type':'ListItem',position:2,name:a.category,item:new URL(href(`categoria/${categorySlug(a.category)}/`),Astro.site).href},{'@type':'ListItem',position:3,name:a.title,item:url}]})}/></Fragment>
<article><header class="article-head"><nav class="breadcrumbs" aria-label="Caminho de navegação"><a href={href()}>Início</a><span aria-hidden="true">/</span><a href={href(`categoria/${categorySlug(a.category)}/`)}>{a.category}</a><span aria-hidden="true">/</span><span>Notícia</span></nav><a class="eyebrow" href={href(`categoria/${categorySlug(a.category)}/`)}>{a.category}</a><span class="badge">{a.confidence}</span><h1>{a.title}</h1><p class="dek">{a.description}</p><div class="article-byline"><strong>Redação FrameNexo</strong> · <time datetime={a.publishedAt}>{date(a.publishedAt)}, {time(a.publishedAt)} BRT</time> · {reading(a)} min de leitura{a.updatedAt!==a.publishedAt&&<span> · Atualizado em {date(a.updatedAt)}, {time(a.updatedAt)} BRT</span>}</div></header>
<figure class="article-figure"><img src={href(a.image)} alt={a.imageAlt} width="1440" height="810" fetchpriority="high"/><figcaption>{a.imageCredit}</figcaption></figure><div class="article-text"><Content/><aside class="source-box"><h2>De onde vem a informação</h2><p>{a.confidence==='RELATO'?'Relato atribuído ao autor da fonte. Não é uma análise do FrameNexo.':'O anúncio é sustentado pela fonte oficial. Isso não equivale a avaliação independente do produto.'}</p><ul>{a.sources.map(s=><li><a href={s.url} rel="noopener noreferrer">{s.name} ↗</a> <time datetime={s.publishedAt}>— {date(s.publishedAt)}</time></li>)}</ul></aside><p class="disclosure">Texto produzido com apoio de IA. Leia a <a href={href('politica-editorial/')}>política editorial</a> para conhecer as verificações e os limites da automação.</p>{a.corrections?.length>0&&<section><h2>Correções</h2>{a.corrections.map(c=><p class="disclosure"><time datetime={c.date}>{date(c.date)}</time> — {c.text}</p>)}</section>}<nav class="tags" aria-label="Tags">{a.tags.map(t=><a href={`${href('busca/')}?q=${encodeURIComponent(t)}`}>{t}</a>)}</nav></div></article>
{related.length>0&&<section class="page-section"><div class="section-heading"><h2>Continue a leitura</h2></div><div class="cards">{related.map(b=><Card article={b}/>)}</div></section>}</Base>

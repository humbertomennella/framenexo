---
import Base from '../../layouts/Base.astro';import Card from '../../components/Card.astro';import {articles,articleUrl,href,date,time,reading,categorySlug,jsonld,usesEditorialCover} from '../../lib/news';
import EditorialCover from '../../components/EditorialCover.astro';
export function getStaticPaths(){return articles.map(a=>({params:{slug:a.slug},props:{article:a}}))}
const {article:a}=Astro.props;const Content=a.Content;const url=new URL(articleUrl(a),Astro.site).href;const useEditorialCover=usesEditorialCover(a);
const newsSchema:any={'@context':'https://schema.org','@type':'NewsArticle',headline:a.title,description:a.description,datePublished:a.publishedAt,dateModified:a.updatedAt,mainEntityOfPage:url,author:{'@type':'Organization',name:'Redação Verídia',url:new URL(href('sobre/'),Astro.site).href},publisher:{'@type':'Organization',name:'Verídia'},articleSection:a.category,keywords:a.tags.join(', '),citation:a.sources.map(s=>s.url)};
if(!useEditorialCover)newsSchema.image=[new URL(href(a.image),Astro.site).href];
const related=articles.filter(b=>b.slug!==a.slug&&(b.category===a.category||b.tags.some(t=>a.tags.includes(t)))).slice(0,3);
---
<Base title={a.title} description={a.description} image={useEditorialCover?'':a.image} article><Fragment slot="head"><meta property="article:published_time" content={a.publishedAt}/><meta property="article:modified_time" content={a.updatedAt}/><script type="application/ld+json" set:html={jsonld(newsSchema)}/><script type="application/ld+json" set:html={jsonld({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Início',item:new URL(href(),Astro.site).href},{'@type':'ListItem',position:2,name:a.category,item:new URL(href(`categoria/${categorySlug(a.category)}/`),Astro.site).href},{'@type':'ListItem',position:3,name:a.title,item:url}]})}/></Fragment>
<article><header class="article-head"><nav class="breadcrumbs" aria-label="Caminho de navegação"><a href={href()}>Início</a><span aria-hidden="true">/</span><a href={href(`categoria/${categorySlug(a.category)}/`)}>{a.category}</a><span aria-hidden="true">/</span><span>Notícia</span></nav><a class="eyebrow" href={href(`categoria/${categorySlug(a.category)}/`)}>{a.category}</a><span class="badge">{a.confidence}</span><h1>{a.title}</h1><p class="dek">{a.description}</p><div class="article-byline"><strong>Redação Verídia</strong> · <time datetime={a.publishedAt}>{date(a.publishedAt)}, {time(a.publishedAt)} BRT</time> · {reading(a)} min de leitura{a.updatedAt!==a.publishedAt&&<span> · Atualizado em {date(a.updatedAt)}, {time(a.updatedAt)} BRT</span>}</div></header>
<figure class="article-figure">{useEditorialCover?<EditorialCover article={a}/>:<img src={href(a.image)} alt={a.imageAlt} width="1440" height="810" fetchpriority="high"/>}<figcaption>{useEditorialCover?'Capa editorial tipográfica da Verídia. Não representa fotografia do acontecimento.':a.imageCredit}</figcaption></figure>
<div class="article-reading"><aside class="quick-read"><span class="eyebrow">Leitura rápida</span><h2>Em 30 segundos</h2><p>{a.description}</p><ul>{(a.quickTakeaways||[a.description]).map(item=><li>{item}</li>)}</ul><a href="#contexto" class="quick-jump">Ler o contexto completo ↓</a></aside><div class="article-text"><div id="contexto" class="article-context"><span class="eyebrow">Contexto e detalhes</span><Content/></div><aside class="source-box"><h2>De onde vem a informação</h2><p>{a.confidence==='RELATO'?'Relato atribuído ao autor da fonte. Não é uma análise da Verídia.':'A matéria é sustentada pela fonte indicada. Isso não equivale a avaliação independente.'}</p><ul>{a.sources.map(s=><li><a href={s.url} rel="noopener noreferrer">{s.name} ↗</a> <time datetime={s.publishedAt}>— {date(s.publishedAt)}</time></li>)}</ul></aside><p class="disclosure">Texto produzido com apoio do sistema editorial Lumen. Leia a <a href={href('politica-editorial/')}>política editorial</a> para conhecer as verificações e os limites da automação.</p>{a.corrections?.length>0&&<section><h2>Correções</h2>{a.corrections.map(c=><p class="disclosure"><time datetime={c.date}>{date(c.date)}</time> — {c.text}</p>)}</section>}<nav class="tags" aria-label="Tags">{a.tags.map(t=><a href={`${href('busca/')}?q=${encodeURIComponent(t)}`}>{t}</a>)}</nav></div></div></article>
{related.length>0&&<section class="page-section"><div class="section-heading"><h2>Continue a leitura</h2></div><div class="cards">{related.map(b=><Card article={b}/>)}</div></section>}</Base>

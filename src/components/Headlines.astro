---
import {articleUrl,href,date,time,categorySlug} from '../lib/news';
const {articles:items=[]}=Astro.props;
---
<section class="headlines" aria-label="Notícias em destaque" aria-roledescription="carrossel" data-headlines>
 <div class="headlines-bar"><span><i class="live-dot"></i><strong>Em foco</strong></span><span class="headlines-position"><b data-position>01</b> / {String(items.length).padStart(2,'0')}</span></div>
 <div class="headlines-track">{items.map((a:any,i:number)=><article class:list={['headline-slide',i===0&&'is-current']} data-slide aria-label={`${i+1} de ${items.length}`} aria-roledescription="slide" aria-hidden={i===0?'false':'true'}>
  <figure class="headline-photo"><a href={articleUrl(a)} tabindex="-1" aria-hidden="true"><img src={href(a.image)} alt={a.imageAlt} width="1600" height="900" loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':'auto'} decoding="async"/></a><figcaption>{a.imageCredit}</figcaption></figure>
  <div class="headline-content"><a class="eyebrow" href={href(`categoria/${categorySlug(a.category)}/`)}>{a.category}</a><h2><a href={articleUrl(a)}>{a.title}</a></h2><p>{a.description}</p><div class="meta"><time datetime={a.publishedAt}>{date(a.publishedAt)} · {time(a.publishedAt)} BRT</time></div><a class="headline-read" href={articleUrl(a)}>Ler a matéria <span aria-hidden="true">↗</span></a></div>
 </article>)}<div class="headlines-controls" aria-label="Controles do destaque"><button type="button" data-previous aria-label="Notícia anterior">←</button><button type="button" data-pause aria-label="Pausar troca automática de notícias">Pausar</button><button type="button" data-next aria-label="Próxima notícia">→</button></div></div>
 <div class="headlines-dots" role="group" aria-label="Selecionar destaque">{items.map((a:any,i:number)=><button type="button" data-go={i} aria-label={`Destaque ${i+1}: ${a.title}`} aria-current={i===0?'true':undefined}><span></span></button>)}</div>
 <p class="sr-only" role="status" data-carousel-status></p>
</section>
<script>
document.querySelectorAll<HTMLElement>('[data-headlines]').forEach(root=>{
 const slides=[...root.querySelectorAll<HTMLElement>('[data-slide]')];
 const dots=[...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
 const pause=root.querySelector<HTMLButtonElement>('[data-pause]')!;
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 let index=0,paused=reduced.matches,hover=false,focused=false,timer:ReturnType<typeof setTimeout>|undefined;
 const schedule=()=>{clearTimeout(timer);if(!paused&&!hover&&!focused&&!document.hidden&&slides.length>1)timer=setTimeout(()=>show(index+1),8000);};
 const show=(next:number,manual=false)=>{index=(next+slides.length)%slides.length;slides.forEach((slide,i)=>{slide.classList.toggle('is-current',i===index);slide.inert=i!==index;slide.setAttribute('aria-hidden',String(i!==index));});dots.forEach((dot,i)=>i===index?dot.setAttribute('aria-current','true'):dot.removeAttribute('aria-current'));root.querySelector('[data-position]')!.textContent=String(index+1).padStart(2,'0');if(manual)root.querySelector('[data-carousel-status]')!.textContent=`Destaque ${index+1} de ${slides.length}`;schedule();};
 const updatePause=()=>{pause.textContent=paused?'Reproduzir':'Pausar';pause.setAttribute('aria-label',paused?'Iniciar troca automática de notícias':'Pausar troca automática de notícias');schedule();};
 const focusState=()=>{focused=root.contains(document.activeElement);schedule();};
 root.classList.add('is-enhanced');show(0);updatePause();
 root.querySelector('[data-previous]')?.addEventListener('click',()=>show(index-1,true));root.querySelector('[data-next]')?.addEventListener('click',()=>show(index+1,true));dots.forEach((dot,i)=>dot.addEventListener('click',()=>show(i,true)));pause.addEventListener('click',()=>{paused=!paused;updatePause();});
 root.addEventListener('mouseenter',()=>{hover=true;schedule();});root.addEventListener('mouseleave',()=>{hover=false;schedule();});root.addEventListener('focusin',focusState);root.addEventListener('focusout',()=>setTimeout(focusState,0));root.addEventListener('keydown',event=>{if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();show(index+(event.key==='ArrowRight'?1:-1),true);}});
 let touchX=0,touchY=0;root.addEventListener('touchstart',e=>{touchX=e.changedTouches[0].clientX;touchY=e.changedTouches[0].clientY;},{passive:true});root.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-touchX,dy=e.changedTouches[0].clientY-touchY;if(Math.abs(dx)>65&&Math.abs(dx)>Math.abs(dy)){paused=true;show(index+(dx<0?1:-1),true);updatePause();}},{passive:true});
 document.addEventListener('visibilitychange',schedule);reduced.addEventListener('change',()=>{paused=reduced.matches;updatePause();});
});
</script>

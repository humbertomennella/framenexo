---
import {articleUrl,href,date,time,categorySlug} from '../lib/news';
const {articles:items=[],variant='focus'}=Astro.props;
const moment=variant==='moment';
const label=moment?'URGENTE':'Em foco';
---
<section class:list={['headlines',moment&&'moment-panel']} aria-label={label} aria-roledescription="carrossel" data-headlines data-interval="3800" data-moment={moment||undefined}>
 <div class="headlines-bar"><div><h2><i class="live-dot" aria-hidden="true"></i>{label}</h2>{moment&&<p>Monitoramento 24h · somente fatos urgentes verificados.</p>}</div><span class="headlines-position" aria-hidden="true"><b data-position>{items.length?'01':'00'}</b> / <span data-total>{String(items.length).padStart(2,'0')}</span></span></div>
 <div class="headlines-track">{items.map((a:any,i:number)=><article class:list={['headline-slide',i===0&&'is-current']} data-slide data-article={a.slug} data-level={a.highlightLevel||'normal'} data-expires={moment?a.highlightExpiresAt:undefined} aria-label={`${i+1} de ${items.length}`} aria-roledescription="slide" aria-hidden={i===0?'false':'true'} inert={i!==0}>
  <figure class="headline-photo"><a href={articleUrl(a)} tabindex="-1" aria-hidden="true"><img src={href(a.image)} alt="" width="1200" height="675" loading={!moment&&i===0?'eager':'lazy'} fetchpriority={!moment&&i===0?'high':'auto'} decoding="async"/></a></figure>
  <div class="headline-content"><div class="headline-kicker"><a class="eyebrow" href={href(`categoria/${categorySlug(a.category)}/`)}>{a.category}</a></div><h3><a href={articleUrl(a)}>{a.title}</a></h3>{!moment&&<p>{a.description}</p>}<div class="meta"><time datetime={a.publishedAt}>{date(a.publishedAt)} · {time(a.publishedAt)}</time></div><a class="headline-read" href={articleUrl(a)}>Ler a matéria <span aria-hidden="true">↗</span></a></div>
 </article>)}</div>
 <div class="carousel-empty" hidden={items.length>0} data-empty><p>Nenhum alerta urgente verificado está vigente nesta edição.</p><a href={href('ultimas/')}>Consultar últimas publicações ↗</a></div>
 <div class="carousel-footer" hidden={items.length<2} data-controls><div class="headlines-dots" role="group" aria-label="Selecionar destaque">{items.map((a:any,i:number)=><button type="button" data-go={i} aria-label={`Destaque ${i+1}: ${a.title}`} aria-current={i===0?'true':undefined}><span></span></button>)}</div><div class="headlines-controls"><button type="button" data-previous aria-label="Notícia anterior">←</button><button type="button" data-next aria-label="Próxima notícia">→</button></div></div>
 <p class="sr-only" role="status" data-carousel-status></p>
</section>
<script>
document.querySelectorAll<HTMLElement>('[data-headlines]').forEach(root=>{
 const allSlides=[...root.querySelectorAll<HTMLElement>('[data-slide]')];
 const dots=[...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 const interval=Number(root.dataset.interval)||3800;
 root.style.setProperty('--carousel-interval',`${interval}ms`);
 let slides=allSlides,index=0,hover=false,timer:ReturnType<typeof setTimeout>|undefined;
 const restartProgress=()=>{const dot=dots[allSlides.indexOf(slides[index])];if(!dot)return;dot.removeAttribute('aria-current');void dot.offsetWidth;dot.setAttribute('aria-current','true');};
 const schedule=()=>{
  clearTimeout(timer);
  const blocked=reduced.matches||hover||document.hidden||slides.length<2;
  root.classList.toggle('is-timer-paused',blocked);
  if(!blocked){restartProgress();timer=setTimeout(()=>show(index+1,false,1),interval);}
 };
 const expire=()=>{
  if(!root.hasAttribute('data-moment'))return;
  const now=Date.now();
  slides=allSlides.filter(slide=>{const fresh=Date.parse(slide.dataset.expires||'')>now;slide.hidden=!fresh;const dot=dots[allSlides.indexOf(slide)];if(dot)dot.hidden=!fresh;return fresh;});
  root.querySelector<HTMLElement>('[data-empty]')!.hidden=slides.length>0;
  root.querySelector<HTMLElement>('[data-controls]')!.hidden=slides.length<2;
  root.querySelector('[data-total]')!.textContent=String(slides.length).padStart(2,'0');
 };
 const show=(next:number,manual=false,direction=0)=>{
  const outgoing=allSlides.find(slide=>slide.classList.contains('is-current'));
  expire();index=slides.length?(next+slides.length)%slides.length:0;
  const incoming=slides[index];
  const travel=direction||1;
  allSlides.forEach(slide=>slide.getAnimations().forEach(animation=>animation.cancel()));
  allSlides.forEach(slide=>{const current=slide===incoming;slide.classList.toggle('is-current',current);slide.inert=!current;slide.setAttribute('aria-hidden',String(!current));});
  if(outgoing&&incoming&&outgoing!==incoming&&!reduced.matches){
   outgoing.animate([{opacity:1,transform:'translateX(0)'},{opacity:0,transform:`translateX(${-travel*7}%)`}],{duration:360,easing:'cubic-bezier(.22,.7,.22,1)'});
   incoming.animate([{opacity:0,transform:`translateX(${travel*7}%)`},{opacity:1,transform:'translateX(0)'}],{duration:360,easing:'cubic-bezier(.22,.7,.22,1)'});
  }
  dots.forEach((dot,i)=>allSlides[i]===slides[index]?dot.setAttribute('aria-current','true'):dot.removeAttribute('aria-current'));
  root.querySelector('[data-position]')!.textContent=slides.length?String(index+1).padStart(2,'0'):'00';
  if(manual)root.querySelector('[data-carousel-status]')!.textContent=`Destaque ${index+1} de ${slides.length}`;
  schedule();
 };
 show(0);
 root.querySelector('[data-previous]')?.addEventListener('click',()=>show(index-1,true,-1));root.querySelector('[data-next]')?.addEventListener('click',()=>show(index+1,true,1));dots.forEach((dot,i)=>dot.addEventListener('click',()=>{const target=slides.indexOf(allSlides[i]);show(target,true,target<index?-1:1);}));
 root.addEventListener('mouseenter',()=>{hover=true;schedule();});root.addEventListener('mouseleave',()=>{hover=false;schedule();});
 root.addEventListener('keydown',event=>{if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();const travel=event.key==='ArrowRight'?1:-1;show(index+travel,true,travel);}});
 let touchX=0,touchY=0;root.addEventListener('touchstart',e=>{touchX=e.changedTouches[0].clientX;touchY=e.changedTouches[0].clientY;},{passive:true});root.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-touchX,dy=e.changedTouches[0].clientY-touchY;if(Math.abs(dx)>50&&Math.abs(dx)>Math.abs(dy)){const travel=dx<0?1:-1;show(index+travel,true,travel);}},{passive:true});
 document.addEventListener('visibilitychange',()=>show(index));reduced.addEventListener('change',schedule);
 // Urgent items expire locally and the public edition is checked every minute.
 if(root.hasAttribute('data-moment')){
  setInterval(()=>show(index),30000);
  const initial=allSlides.map(slide=>`${slide.dataset.article}:${slide.dataset.expires}`).join('|');
  let checking=false;
  const checkPublishedEdition=async()=>{
   if(document.hidden||checking)return;
   checking=true;
   try{
    const response=await fetch(location.href,{cache:'no-store',signal:AbortSignal.timeout(10000)});
    if(!response.ok)return;
    const parsed=new DOMParser().parseFromString(await response.text(),'text/html');
    const panel=parsed.querySelector('[data-headlines][data-moment]');
    const next=[...panel?.querySelectorAll<HTMLElement>('[data-slide]')||[]].map(slide=>`${slide.dataset.article}:${slide.dataset.expires}`).join('|');
    if(next!==initial)location.reload();
   }catch{/* Keep the current verified edition if the network check is unavailable. */}
   finally{checking=false;}
  };
  setInterval(checkPublishedEdition,60000);
  document.addEventListener('visibilitychange',checkPublishedEdition);
 }
});
</script>

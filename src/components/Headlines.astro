---
import {articleUrl,href,date,time,categorySlug} from '../lib/news';
const {articles:items=[],variant='focus'}=Astro.props;
const moment=variant==='moment';
const label=moment?'Em Alta':'Em foco';
---
<section class:list={['headlines',moment&&'moment-panel']} aria-label={label} aria-roledescription="carrossel" data-headlines data-interval={moment?'5000':'8000'} data-moment={moment||undefined}>
 <div class="headlines-bar"><div><h2><i class="live-dot" aria-hidden="true"></i>{label}</h2>{moment&&<p>Acompanhe as principais notícias do momento no Brasil.</p>}</div><span class="headlines-position" aria-hidden="true"><b data-position>01</b> / <span data-total>{String(items.length).padStart(2,'0')}</span></span></div>
 <div class="headlines-track">{items.map((a:any,i:number)=><article class:list={['headline-slide',i===0&&'is-current']} data-slide data-level={a.highlightLevel||'normal'} data-expires={moment?a.highlightExpiresAt:undefined} aria-label={`${i+1} de ${items.length}`} aria-roledescription="slide" aria-hidden={i===0?'false':'true'} inert={i!==0}>
  <figure class="headline-photo"><a href={articleUrl(a)} tabindex="-1" aria-hidden="true"><img src={href(a.image)} alt="" width="1200" height="675" loading={!moment&&i===0?'eager':'lazy'} fetchpriority={!moment&&i===0?'high':'auto'} decoding="async"/></a></figure>
  <div class="headline-content"><div class="headline-kicker"><a class="eyebrow" href={href(`categoria/${categorySlug(a.category)}/`)}>{a.category}</a></div><h3><a href={articleUrl(a)}>{a.title}</a></h3>{!moment&&<p>{a.description}</p>}<div class="meta"><time datetime={a.publishedAt}>{date(a.publishedAt)} · {time(a.publishedAt)}</time></div><a class="headline-read" href={articleUrl(a)}>Ler a matéria <span aria-hidden="true">↗</span></a></div>
 </article>)}</div>
 <div class="carousel-empty" hidden={items.length>0} data-empty><p>Os próximos destaques entram aqui após a confirmação dos fatos.</p><a href={href('ultimas/')}>Consultar últimas publicações ↗</a></div>
 <div class="carousel-footer" hidden={items.length<2} data-controls><div class="headlines-dots" role="group" aria-label="Selecionar destaque">{items.map((a:any,i:number)=><button type="button" data-go={i} aria-label={`Destaque ${i+1}: ${a.title}`} aria-current={i===0?'true':undefined}><span></span></button>)}</div><div class="headlines-controls"><button type="button" data-previous aria-label="Notícia anterior">←</button><button type="button" data-next aria-label="Próxima notícia">→</button></div></div>
 <p class="sr-only" role="status" data-carousel-status></p>
</section>
<script>
document.querySelectorAll<HTMLElement>('[data-headlines]').forEach(root=>{
 const allSlides=[...root.querySelectorAll<HTMLElement>('[data-slide]')];
 const dots=[...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 const interval=Number(root.dataset.interval)||8000;
 let slides=allSlides,index=0,hover=false,focused=false,timer:ReturnType<typeof setTimeout>|undefined;
 const schedule=()=>{clearTimeout(timer);if(!reduced.matches&&!hover&&!focused&&!document.hidden&&slides.length>1)timer=setTimeout(()=>show(index+1),interval);};
 const expire=()=>{
  if(!root.hasAttribute('data-moment'))return;
  const now=Date.now();
  slides=allSlides.filter(slide=>{const fresh=Date.parse(slide.dataset.expires||'')>now;slide.hidden=!fresh;const dot=dots[allSlides.indexOf(slide)];if(dot)dot.hidden=!fresh;return fresh;});
  root.querySelector<HTMLElement>('[data-empty]')!.hidden=slides.length>0;
  root.querySelector<HTMLElement>('[data-controls]')!.hidden=slides.length<2;
  root.querySelector('[data-total]')!.textContent=String(slides.length).padStart(2,'0');
 };
 const show=(next:number,manual=false)=>{
  expire();index=slides.length?(next+slides.length)%slides.length:0;
  allSlides.forEach(slide=>{const current=slide===slides[index];slide.classList.toggle('is-current',current);slide.inert=!current;slide.setAttribute('aria-hidden',String(!current));});
  dots.forEach((dot,i)=>allSlides[i]===slides[index]?dot.setAttribute('aria-current','true'):dot.removeAttribute('aria-current'));
  root.querySelector('[data-position]')!.textContent=slides.length?String(index+1).padStart(2,'0'):'00';
  if(manual)root.querySelector('[data-carousel-status]')!.textContent=`Destaque ${index+1} de ${slides.length}`;
  schedule();
 };
 show(0);
 root.querySelector('[data-previous]')?.addEventListener('click',()=>show(index-1,true));root.querySelector('[data-next]')?.addEventListener('click',()=>show(index+1,true));dots.forEach((dot,i)=>dot.addEventListener('click',()=>show(slides.indexOf(allSlides[i]),true)));
 root.addEventListener('mouseenter',()=>{hover=true;schedule();});root.addEventListener('mouseleave',()=>{hover=false;schedule();});root.addEventListener('focusin',()=>{focused=true;schedule();});root.addEventListener('focusout',()=>setTimeout(()=>{focused=root.contains(document.activeElement);schedule();},0));
 root.addEventListener('keydown',event=>{if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();show(index+(event.key==='ArrowRight'?1:-1),true);}});
 let touchX=0,touchY=0;root.addEventListener('touchstart',e=>{touchX=e.changedTouches[0].clientX;touchY=e.changedTouches[0].clientY;},{passive:true});root.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-touchX,dy=e.changedTouches[0].clientY-touchY;if(Math.abs(dx)>65&&Math.abs(dx)>Math.abs(dy))show(index+(dx<0?1:-1),true);},{passive:true});
 document.addEventListener('visibilitychange',()=>show(index));reduced.addEventListener('change',schedule);
 // Expiry still applies while the page stays open.
 if(root.hasAttribute('data-moment'))setInterval(()=>show(index),30000);
});
</script>

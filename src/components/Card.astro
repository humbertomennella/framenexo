---
import {articleUrl,href,date,reading,categorySlug,usesEditorialCover} from '../lib/news';
import EditorialCover from './EditorialCover.astro';
const {article:a}=Astro.props;
const useEditorialCover=usesEditorialCover(a);
---
<article class="card"><a class="card-image" href={articleUrl(a)} tabindex="-1" aria-hidden="true">{useEditorialCover?<EditorialCover article={a} compact/>:<img src={href(a.image)} alt="" width="1200" height="675" loading="lazy" decoding="async"/>}</a><div class="card-body"><a class="eyebrow" href={href(`categoria/${categorySlug(a.category)}/`)}>{a.category}</a><h3><a href={articleUrl(a)}>{a.title}</a></h3><p>{a.description}</p><div class="meta"><time datetime={a.publishedAt}>{date(a.publishedAt)}</time><span>{reading(a)} min de leitura</span><button class="save-button" type="button" data-ap-save data-slug={a.slug} aria-pressed="false" aria-label={`Salvar matéria: ${a.title}`}><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.5 4.5h11v15l-5.5-3.4-5.5 3.4v-15Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg><span data-ap-save-label>Salvar</span></button></div></div></article>

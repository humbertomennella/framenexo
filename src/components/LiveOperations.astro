<section class="notice" aria-label="Estado da operação"><h2>Execução da coleta</h2><p data-operation-live role="status">Consultando o estado público da execução…</p><p class="disclosure">Coleta concluída não significa matéria publicada. A publicação depende da confirmação independente e da mídia aprovada. Este indicador consulta o workflow do repositório; não mede a tarefa externa do ChatGPT.</p></section>
<script>
const target=document.querySelector('[data-operation-live]');
async function refresh(){
 if(!target||document.hidden)return;
 try{
  const response=await fetch('https://api.github.com/repos/humbertomennella/framenexo/actions/workflows/collector.yml/runs?per_page=1',{headers:{Accept:'application/vnd.github+json'},cache:'no-store',signal:AbortSignal.timeout(10000)});
  if(!response.ok)throw Error('unavailable');
  const run=(await response.json()).workflow_runs?.[0];
  if(!run){target.textContent='Nenhuma execução pública localizada.';return;}
  const started=run.run_started_at||run.created_at;
  const when=new Intl.DateTimeFormat('pt-BR',{dateStyle:'short',timeStyle:'short',timeZone:'America/Sao_Paulo'}).format(new Date(started));
  const stale=Date.now()-Date.parse(started)>2*3600000;
  const label=run.status!=='completed'?(run.status==='in_progress'?'Em execução':'Na fila'):run.conclusion==='success'?'Concluída':run.conclusion==='cancelled'?'Cancelada':run.conclusion==='timed_out'?'Tempo limite excedido':'Falha ou execução não concluída com sucesso';
  target.textContent=`${label}. Início: ${when} BRT.${stale?' Sem execução recente nas últimas duas horas.':''}`;
 }catch{target.textContent='Estado ao vivo indisponível. Os registros abaixo pertencem à versão publicada; não confirmam atividade atual.';}
}
refresh();setInterval(refresh,60000);
</script>

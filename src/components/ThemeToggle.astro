<button class="theme-toggle" type="button" data-theme-toggle aria-label="Ativar tema claro" aria-pressed="false" title="Alternar tema">
  <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
  <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
    <path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.6 8.6 0 1 0 20.5 15.2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  </svg>
</button>

<script>
  const THEME_STORAGE_KEY='apurante_theme';
  type Theme='light'|'dark';

  const currentTheme=():Theme=>document.documentElement.dataset.theme==='light'?'light':'dark';

  const syncButton=(button:HTMLButtonElement)=>{
    const light=currentTheme()==='light';
    button.setAttribute('aria-pressed',String(light));
    button.setAttribute('aria-label',light?'Ativar tema escuro':'Ativar tema claro');
    button.title=light?'Usar tema escuro':'Usar tema claro';
  };

  const applyTheme=(theme:Theme,persist=true)=>{
    const root=document.documentElement;
    root.dataset.theme=theme;
    root.style.colorScheme=theme;
    if(persist){try{localStorage.setItem(THEME_STORAGE_KEY,theme);}catch{}}
    const meta=document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    if(meta)meta.content=theme==='light'?'#f5f6f2':'#090a0d';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(syncButton);
  };

  const setupThemeToggle=()=>{
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(button=>{
      syncButton(button);
      if(button.dataset.themeReady==='true')return;
      button.dataset.themeReady='true';
      button.addEventListener('click',()=>applyTheme(currentTheme()==='light'?'dark':'light'));
    });
  };

  setupThemeToggle();
  document.addEventListener('astro:page-load',setupThemeToggle);
  window.addEventListener('storage',event=>{
    if(event.key===THEME_STORAGE_KEY&&(event.newValue==='light'||event.newValue==='dark'))applyTheme(event.newValue,false);
  });
</script>

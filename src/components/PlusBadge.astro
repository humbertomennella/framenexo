---
import {href} from '../lib/news';
const {compact=false,destination='mais/',label='Conhecer o APURANTE+'}=Astro.props;
---
<a class:list={['plus-entry',{'is-compact':compact}]} href={href(destination)} aria-label={label}>
  <span class="plus-text" aria-hidden="true">A+</span><span class="plus-name">APURANTE+</span>
</a>
<style>
.plus-text{display:inline-block;color:var(--accent);font-size:1.08rem;font-weight:950;line-height:1;letter-spacing:-.06em}
.plus-entry:hover .plus-text,.plus-entry:focus-visible .plus-text{color:color-mix(in srgb,var(--accent) 82%,#fff)}
.plus-entry:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:6px}
</style>

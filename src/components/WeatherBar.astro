<section class="weather-shell" data-weather aria-label="Clima local">
  <div class="wrap weather-row">
    <button class="weather-summary" type="button" data-weather-toggle aria-expanded="false" aria-controls="weather-panel">
      <span class="weather-icon" data-weather-icon aria-hidden="true">
        <svg viewBox="0 0 32 32"><path d="M7 22h17a5 5 0 0 0 0-10 8 8 0 0 0-15-2A6 6 0 0 0 7 22Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </span>
      <span class="weather-place" data-weather-city>Escolha sua cidade</span>
      <strong class="weather-temp" data-weather-temp>--°</strong>
      <span class="weather-condition" data-weather-condition>Clima</span>
      <svg class="weather-chevron" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>
    <span class="weather-stamp" data-weather-stamp hidden></span>
  </div>

  <div class="weather-panel" id="weather-panel" data-weather-panel hidden>
    <div class="wrap weather-panel-inner">
      <div class="weather-picker-copy">
        <strong>Tempo na sua cidade</strong>
        <span>Escolha uma cidade para acompanhar as condições atuais.</span>
      </div>
      <form class="weather-search" data-weather-search>
        <label class="sr-only" for="weather-city">Cidade</label>
        <input id="weather-city" name="city" type="search" autocomplete="address-level2" placeholder="Digite sua cidade" minlength="2" required/>
        <button type="submit">Buscar</button>
      </form>
      <div class="weather-results" data-weather-results role="listbox" aria-label="Cidades encontradas"></div>
      <div class="weather-detail" data-weather-detail hidden>
        <span data-weather-detail-condition></span>
        <span data-weather-feels></span>
        <span data-weather-wind></span>
        <button type="button" data-weather-refresh>Atualizar</button>
      </div>
      <p class="weather-feedback" data-weather-feedback role="status"></p>
      <a class="weather-credit" href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Dados meteorológicos: Open-Meteo ↗</a>
    </div>
  </div>
</section>

<script>
import {WEATHER_STORAGE_KEY,WEATHER_CACHE_KEY,WEATHER_CACHE_TTL,weatherPresentation,normalizeLocation} from '../lib/weather.mjs';

const FORECAST_API='https://api.open-meteo.com/v1/forecast';
const GEOCODING_API='https://geocoding-api.open-meteo.com/v1/search';

const iconSvg=(kind)=>{
  const common='viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';
  const icons={
    'clear-day':`<svg ${common}><circle cx="16" cy="16" r="5"/><path d="M16 3v4M16 25v4M3 16h4M25 16h4M6.8 6.8l2.8 2.8M22.4 22.4l2.8 2.8M25.2 6.8l-2.8 2.8M9.6 22.4l-2.8 2.8"/></svg>`,
    'clear-night':`<svg ${common}><path d="M24.5 20.7A10 10 0 0 1 11.3 7.5a10.3 10.3 0 1 0 13.2 13.2Z"/></svg>`,
    'partly-cloudy':`<svg ${common}><circle cx="11" cy="10" r="4"/><path d="M11 2.5v2M3.5 10h2M5.7 4.7l1.4 1.4M16.3 4.7l-1.4 1.4M9 24h15a5 5 0 0 0 0-10 7 7 0 0 0-13-1A5.5 5.5 0 0 0 9 24Z"/></svg>`,
    'cloudy':`<svg ${common}><path d="M7 23h17a5.5 5.5 0 0 0 0-11 8.5 8.5 0 0 0-16-2A6.5 6.5 0 0 0 7 23Z"/></svg>`,
    'fog':`<svg ${common}><path d="M7 18h17a5 5 0 0 0 0-10 8 8 0 0 0-15-2A6 6 0 0 0 7 18ZM5 23h22M8 27h16"/></svg>`,
    'drizzle':`<svg ${common}><path d="M7 18h17a5 5 0 0 0 0-10 8 8 0 0 0-15-2A6 6 0 0 0 7 18ZM10 22l-1 3M16 22l-1 3M22 22l-1 3"/></svg>`,
    'rain':`<svg ${common}><path d="M7 17h17a5 5 0 0 0 0-10 8 8 0 0 0-15-2A6 6 0 0 0 7 17ZM10 21l-2 6M17 21l-2 6M24 21l-2 6"/></svg>`,
    'cold-rain':`<svg ${common}><path d="M7 16h17a5 5 0 0 0 0-10 8 8 0 0 0-15-2A6 6 0 0 0 7 16ZM10 21l-2 5M22 21l-2 5M16 20v8M12.5 22l7 4M19.5 22l-7 4"/></svg>`,
    'snow':`<svg ${common}><path d="M16 3v26M7 8l18 16M25 8 7 24M11 5l5 3 5-3M11 27l5-3 5 3M5 13l3 5-3 5M27 13l-3 5 3 5"/></svg>`,
    'cold':`<svg ${common}><path d="M16 4v24M9 8l14 16M23 8 9 24M12 5l4 3 4-3M12 27l4-3 4 3"/></svg>`,
    'storm':`<svg ${common}><path d="M7 17h17a5 5 0 0 0 0-10 8 8 0 0 0-15-2A6 6 0 0 0 7 17Z"/><path d="m17 19-4 7h4l-2 4 7-8h-4l2-3"/></svg>`
  };
  return icons[kind]||icons.cloudy;
};

const readJson=(key)=>{try{return JSON.parse(localStorage.getItem(key)||'null')}catch{return null}};
const saveJson=(key,value)=>{try{localStorage.setItem(key,JSON.stringify(value))}catch{}};

const setupWeather=(root)=>{
  if(root.dataset.ready==='true')return;
  root.dataset.ready='true';
  const toggle=root.querySelector('[data-weather-toggle]');
  const panel=root.querySelector('[data-weather-panel]');
  const cityEl=root.querySelector('[data-weather-city]');
  const tempEl=root.querySelector('[data-weather-temp]');
  const conditionEl=root.querySelector('[data-weather-condition]');
  const iconEl=root.querySelector('[data-weather-icon]');
  const stampEl=root.querySelector('[data-weather-stamp]');
  const search=root.querySelector('[data-weather-search]');
  const input=search.querySelector('input');
  const results=root.querySelector('[data-weather-results]');
  const detail=root.querySelector('[data-weather-detail]');
  const detailCondition=root.querySelector('[data-weather-detail-condition]');
  const feels=root.querySelector('[data-weather-feels]');
  const wind=root.querySelector('[data-weather-wind]');
  const feedback=root.querySelector('[data-weather-feedback]');
  const refresh=root.querySelector('[data-weather-refresh]');
  let currentLocation=readJson(WEATHER_STORAGE_KEY);
  let busy=false;

  const setOpen=(open)=>{
    panel.hidden=!open;
    toggle.setAttribute('aria-expanded',String(open));
    if(open)setTimeout(()=>input.focus(),0);
  };

  const render=(weather,location,cached=false)=>{
    const current=weather.current||weather;
    const temperature=Math.round(Number(current.temperature_2m));
    const presentation=weatherPresentation(Number(current.weather_code),Number(current.is_day),temperature);
    cityEl.textContent=location.name;
    tempEl.textContent=`${temperature}°`;
    conditionEl.textContent=presentation.label;
    iconEl.innerHTML=iconSvg(presentation.kind);
    detail.hidden=false;
    detailCondition.textContent=presentation.label;
    feels.textContent=`Sensação ${Math.round(Number(current.apparent_temperature))}°`;
    wind.textContent=`Vento ${Math.round(Number(current.wind_speed_10m))} km/h`;
    stampEl.hidden=false;
    stampEl.textContent=cached?'Dados salvos · atualizando':'Atualizado agora';
    feedback.textContent='';
  };

  const fetchWeather=async(location,{force=false}={})=>{
    if(!location||busy)return;
    const cached=readJson(WEATHER_CACHE_KEY);
    const same=cached?.location&&Number(cached.location.latitude)===Number(location.latitude)&&Number(cached.location.longitude)===Number(location.longitude);
    if(!force&&same&&Date.now()-Number(cached.at)<WEATHER_CACHE_TTL){render(cached.weather,location,false);return;}
    if(same&&cached?.weather)render(cached.weather,location,true);
    busy=true;
    feedback.textContent='Atualizando clima…';
    try{
      const url=new URL(FORECAST_API);
      url.searchParams.set('latitude',String(location.latitude));
      url.searchParams.set('longitude',String(location.longitude));
      url.searchParams.set('current','temperature_2m,apparent_temperature,weather_code,is_day,precipitation,rain,snowfall,wind_speed_10m');
      url.searchParams.set('temperature_unit','celsius');
      url.searchParams.set('wind_speed_unit','kmh');
      url.searchParams.set('timezone','auto');
      const response=await fetch(url,{cache:'no-store',signal:AbortSignal.timeout(10000)});
      if(!response.ok)throw new Error('weather');
      const weather=await response.json();
      saveJson(WEATHER_CACHE_KEY,{at:Date.now(),location,weather});
      render(weather,location,false);
    }catch{
      feedback.textContent=same&&cached?.weather?'Não foi possível atualizar agora. Exibindo o último dado disponível.':'Clima indisponível no momento. Tente novamente em instantes.';
      stampEl.textContent=same&&cached?.weather?'Última atualização salva':'';
    }finally{busy=false;}
  };

  const renderResults=(entries)=>{
    results.replaceChildren();
    entries.forEach((entry,index)=>{
      const location=normalizeLocation(entry);
      const button=document.createElement('button');
      button.type='button';
      button.setAttribute('role','option');
      button.dataset.index=String(index);
      const primary=document.createElement('strong');primary.textContent=location.name;
      const secondary=document.createElement('span');secondary.textContent=[location.admin1,location.country].filter(Boolean).join(' · ');
      button.append(primary,secondary);
      button.addEventListener('click',async()=>{
        currentLocation=location;
        saveJson(WEATHER_STORAGE_KEY,location);
        results.replaceChildren();
        await fetchWeather(location,{force:true});
        setOpen(false);
      });
      results.append(button);
    });
  };

  toggle.addEventListener('click',()=>setOpen(panel.hidden));
  document.addEventListener('click',event=>{if(!panel.hidden&&!root.contains(event.target))setOpen(false)});
  document.addEventListener('keydown',event=>{if(event.key==='Escape'&&!panel.hidden){setOpen(false);toggle.focus();}});

  search.addEventListener('submit',async event=>{
    event.preventDefault();
    const term=input.value.trim();
    if(term.length<2)return;
    feedback.textContent='Buscando cidades…';results.replaceChildren();
    try{
      const url=new URL(GEOCODING_API);
      url.searchParams.set('name',term);url.searchParams.set('count','6');url.searchParams.set('language','pt');url.searchParams.set('format','json');
      const response=await fetch(url,{cache:'no-store',signal:AbortSignal.timeout(10000)});
      if(!response.ok)throw new Error('search');
      const data=await response.json();
      const entries=Array.isArray(data.results)?data.results:[];
      renderResults(entries);
      feedback.textContent=entries.length?'Selecione sua cidade.':'Nenhuma cidade encontrada. Tente incluir o estado.';
    }catch{feedback.textContent='Não foi possível buscar cidades agora.';}
  });

  refresh.addEventListener('click',()=>currentLocation&&fetchWeather(currentLocation,{force:true}));
  if(currentLocation)fetchWeather(currentLocation);
  setInterval(()=>currentLocation&&fetchWeather(currentLocation,{force:true}),WEATHER_CACHE_TTL);
  document.addEventListener('visibilitychange',()=>{if(!document.hidden&&currentLocation)fetchWeather(currentLocation)});
};

document.querySelectorAll('[data-weather]').forEach(setupWeather);
document.addEventListener('astro:page-load',()=>document.querySelectorAll('[data-weather]').forEach(setupWeather));
</script>

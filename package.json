{
  "name": "framenexo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "test": "python3 -m unittest discover -s tests -v && node --test tests/*.test.mjs",
    "check:site": "python3 scripts/check_site.py",
    "collect": "python3 scripts/pipeline.py collect",
    "publish": "python3 scripts/pipeline.py publish",
    "pipeline": "python3 scripts/run_editorial.py",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
